# =========================================================
# Copie para .env e preencha com SUAS credenciais:
#     cp .env.example .env
#
# O arquivo .env esta no .gitignore e NUNCA deve ser commitado.
# Este .example nao contem nenhuma credencial real.
#
# Politica de senha do Azure SQL (conferida pelo scripts/00-vars.sh):
# 8 a 128 caracteres, com pelo menos 3 destes 4 grupos -- maiusculas,
# minusculas, numeros e simbolos -- e sem conter o nome do usuario.
#
# Este arquivo e lido pelo bash (source). Prefira senhas com letras,
# numeros e os simbolos @ # % + - _ ! . ; qualquer outro simbolo ($, aspas,
# espaco, &, ;) exige o valor inteiro entre aspas simples, por exemplo
# APP_DB_PASSWORD='Senha$Com&Simbolos9'
# =========================================================

# Administrador do servidor Azure SQL. Usado SOMENTE pelos scripts, para
# criar o banco, executar o DDL e criar o usuario da aplicacao.
# Nomes reservados como admin, sa ou root sao recusados pela Azure.
SQL_ADMIN_USER=troque_este_usuario
SQL_ADMIN_PASSWORD=troque_esta_senha

# Usuario da aplicacao (usuario contido no banco, so leitura e escrita).
# E com ele que a Web App se conecta: o 04-webapp.sh grava estes valores
# como app settings DB_USER e DB_PASSWORD.
APP_DB_USER=troque_este_usuario
APP_DB_PASSWORD=troque_esta_senha

# ---------------------------------------------------------
# (Opcional) Executar a aplicacao localmente contra o Azure SQL.
# A entrega roda no App Service; isto serve so para desenvolvimento.
# O scripts/02-sql.sh libera no firewall o IP de onde ele foi executado.
# A URL leva aspas porque contem ';'.
# ---------------------------------------------------------
# DB_URL="jdbc:sqlserver://<servidor>.database.windows.net:1433;database=db-dimdim;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;"
# DB_USER=<mesmo valor de APP_DB_USER>
# DB_PASSWORD=<mesmo valor de APP_DB_PASSWORD>
